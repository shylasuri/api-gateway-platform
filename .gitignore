# ─────────────────────────────────────────────────────────────
# Environment / secrets  —  NEVER commit real values.
# .env.example is intentionally tracked as a template.
# ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example

# Keys / certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub

# ─────────────────────────────────────────────────────────────
# Backend (Maven / Java)
# ─────────────────────────────────────────────────────────────
backend/target/
target/
*.class
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/*.properties
HELP.md

# ─────────────────────────────────────────────────────────────
