# Copy this file to .env and adjust values for your machine.
# docker-compose reads variables from .env automatically.
# NEVER commit a real .env file — it is already listed in .gitignore.

# ---- Database ----
DATABASE_NAME=api_gateway_platform
DATABASE_URL=jdbc:postgresql://localhost:5432/api_gateway_platform
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=local-development-only-change-me-this-must-be-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# ---- Stripe (TEST MODE ONLY) ----
# Leave blank for local development without Stripe — the app calculates
# billing/overage from real usage data regardless, and only skips syncing
# customers/subscriptions to Stripe when these are unset. Get test keys from
# https://dashboard.stripe.com/test/apikeys — never put live keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:8080

# ---- Sample backend API ----
SAMPLE_API_URL=http://sample-api:8081/products

# ---- Seed data (local development only) ----
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@gateway.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_CONSUMER_EMAIL=consumer@gateway.local
SEED_CONSUMER_PASSWORD=Consumer123!
