# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION environment variables (template — do NOT commit real values).
# Set these in the Render dashboard (backend) and Vercel (frontend).
# The backend runs with SPRING_PROFILES_ACTIVE=prod, which REQUIRES every
# secret below — it refuses to start if one is missing.
# ─────────────────────────────────────────────────────────────────────────

# ---- Backend (Render) ----
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL — Neon. Use the JDBC form with SSL required.
DATABASE_URL=jdbc:postgresql://<neon-host>/<db>?sslmode=require
DATABASE_USERNAME=<neon-user>
DATABASE_PASSWORD=<neon-password>

# Redis — Upstash (TLS + password required).
REDIS_HOST=<upstash-host>
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=<upstash-password>
REDIS_SSL=true

# JWT — generate a strong secret: openssl rand -base64 48  (min 32 chars)
JWT_SECRET=<strong-random-32+-char-secret>

# CORS / links — your deployed frontend origin (no trailing slash).
FRONTEND_URL=https://<your-app>.vercel.app

# Where the seeded "Products API" forwards to (the sample-api service).
SAMPLE_API_URL=https://gateway-sample-api.onrender.com/products

# Seed accounts — strong values; these are the logins your demo will use.
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=<strong-password>
SEED_CONSUMER_EMAIL=demo@yourdomain.com
SEED_CONSUMER_PASSWORD=<strong-password>

# Email — Resend (https://resend.com). Password-reset links are emailed.
RESEND_API_KEY=<resend-api-key>
MAIL_FROM=GatewayPlatform <noreply@yourdomain.com>

# Reset tokens are never exposed over the API in prod (forced false by the prod profile).
PASSWORD_RESET_EXPOSE_TOKEN=false

# ---- Frontend (Vercel) ----
# Absolute backend origin so the SPA calls the API directly (no trailing slash).
VITE_API_BASE_URL=https://gateway-backend.onrender.com
